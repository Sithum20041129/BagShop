{
  "name": "brightbuy-bagshop",
  "version": "2.0.0",
  "description": "Bright Buy — Minimalist Luxury Bags E-Commerce Platform on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bagshop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bagshop-db --remote",
    "db:seed:local": "wrangler d1 execute bagshop-db --local --file=scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute bagshop-db --remote --file=scripts/seed.sql"
  },
  "dependencies": {
    "@clerk/backend": "^3.33.1",
    "@clerk/react": "^6.19.7",
    "@tanstack/react-query": "^5.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.5",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.0.17",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.6",
    "tailwindcss": "^4.0.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.6.0"
  }
}
