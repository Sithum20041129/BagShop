# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Authentication (JWT Secret for local token handling)
JWT_SECRET=brightbuy_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Clerk Authentication (Third-Party Service)
# Obtain these from your Clerk Dashboard (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
CLERK_JWT_KEY=
